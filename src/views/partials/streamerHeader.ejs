<!-- src/views/partials/streamerHeader.ejs -->
<div class="header">
  <div class="brand">
    <div class="brand-dot"></div>
    <div>
      <h1><%= pageTitle || title || "Streamer Dashboard" %></h1>
      <div class="sub"><%= pageSub || "Configure your overlays and factions" %></div>
    </div>
  </div>

  <div class="nav">
    <a href="/admin" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/admin/layouts" class="<%= activeTab === 'layouts' ? 'active' : '' %>">Layouts</a>
    <a href="/admin/factions" class="<%= activeTab === 'factions' ? 'active' : '' %>">Factions</a>
    <a href="/admin/meters" class="<%= activeTab === 'meters' ? 'active' : '' %>">Meters</a>
    <a href="/admin/billing" class="<%= activeTab === 'billing' ? 'active' : '' %>">Billing</a>
    <a href="/admin/chat" class="<%= activeTab === 'chat' ? 'active' : '' %>">Chat</a>
    <a href="/admin/event-api" class="<%= activeTab === 'eventApi' ? 'active' : '' %>">Event API</a>
    <a href="/admin/companion-key" class="<%= activeTab === 'companionKey' ? 'active' : '' %>">Companion</a>

    <!-- Wiki: new tab -->
    <a
      href="/wiki"
      target="_blank"
      rel="noopener noreferrer"
      class="<%= activeTab === 'wiki' ? 'active' : '' %>"
      title="Open Wiki in a new tab"
    >Wiki</a>

    <!-- Wiki: slide-out drawer toggle -->
    <button
      type="button"
      class="nav-wiki-btn"
      id="wikiToggleBtn"
      aria-label="Toggle Wiki panel"
      title="Toggle Wiki panel"
    >?</button>
  </div>
</div>

<!-- Slide-out Wiki Drawer -->
<div class="wiki-backdrop" id="wikiBackdrop" data-wiki-close></div>

<div class="wiki-drawer" id="wikiDrawer" aria-hidden="true">
  <div class="wiki-drawer-header">
    <div class="wiki-drawer-title">Wiki</div>

    <div style="display:flex; gap:8px; align-items:center;">
      <a class="btn" href="/wiki" target="_blank" rel="noopener noreferrer">Open full</a>
      <button type="button" class="btn" data-wiki-close>Close</button>
    </div>
  </div>

  <iframe
    class="wiki-drawer-frame"
    id="wikiDrawerFrame"
    src="/wiki"
    title="Chat Factions Wiki"
    loading="lazy"
    referrerpolicy="no-referrer"
  ></iframe>
</div>

<!-- CSP-safe: external JS only -->
<script src="/public/js/wikiDrawer.js" defer></script>
