<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%= (title || 'Wiki') %> — Chat Factions</title>
    <link rel="stylesheet" href="/public/css/app.css" />
  </head>
  <body>
    <div class="container">

      <div class="header">
        <div class="brand">
          <div class="brand-dot"></div>
          <div>
            <h1>Chat Factions Wiki</h1>
            <div class="sub">Setup, OBS help, and overlay documentation</div>
          </div>
        </div>

        <div class="nav">
          <a href="/wiki" class="<%= (path === '/' || path === 'index') ? 'active' : '' %>">Home</a>
          <a href="/wiki/basics" class="<%= String(path || '').startsWith('basics') ? 'active' : '' %>">Basics</a>
          <a href="/wiki/overlays" class="<%= String(path || '').startsWith('overlays') ? 'active' : '' %>">Overlays</a>
          <a href="/wiki/commands" class="<%= String(path || '').startsWith('commands') ? 'active' : '' %>">Commands</a>
          <a href="/wiki/troubleshooting" class="<%= String(path || '').startsWith('troubleshooting') ? 'active' : '' %>">Help</a>
        </div>
      </div>

      <div class="card">
        <article class="wiki-content">
          <%- content %>
        </article>
      </div>

      <div class="small muted" style="margin-top:12px;">
        <a href="/admin">Back to Dashboard</a>
      </div>

    </div>
  </body>
</html>
